# DevAPI Hub — root env example
# Copy server/.env.example to server/.env and adjust:
#   cp server/.env.example server/.env
# Copy client/.env.example to client/.env and adjust:
#   cp client/.env.example client/.env

# Backend (server/.env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/devapi-hub
JWT_ACCESS_SECRET=change-me-access-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-32chars-min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
GLOBAL_RATE_WINDOW_MS=60000
GLOBAL_RATE_MAX=300

# Frontend (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_GATEWAY_URL=http://localhost:5000/gateway
VITE_SOCKET_URL=http://localhost:5000
VITE_DOCS_URL=http://localhost:5000/api-docs
