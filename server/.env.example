# DevAPI Hub - Server environment
# Copy to server/.env and replace every placeholder before running.
# In production, JWT secrets are REQUIRED (the server refuses default/insecure values).

PORT=5000
NODE_ENV=development

# MongoDB (local or docker service name in compose)
MONGO_URI=mongodb://localhost:27017/devapi-hub

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<replace-with-long-random-string>
JWT_REFRESH_SECRET=<replace-with-long-random-string>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis is OPTIONAL — the app falls back to in-memory rate limiting/caching.
REDIS_URL=redis://localhost:6379

# CORS / socket origin of the frontend
FRONTEND_URL=http://localhost:5173

# Global HTTP rate limit (all /api routes)
GLOBAL_RATE_WINDOW_MS=60000
GLOBAL_RATE_MAX=300

# Set true in production (docker compose) to auto-seed the public demo account
SEED_DEMO=false
